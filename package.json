{
  "name": "vanilla-js-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Webpack 5 starter for plain JavaScript projects",
  "scripts": {
    "build": "webpack --config webpack.config.prod.js",
    "dev": "webpack serve --config webpack.config.dev.js",
    "deploy": "npm run format && npm run build && gh-pages -d dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilipNowakWay/vanilla-js-boilerplate.git"
  },
  "keywords": [
    "vanilla-js",
    "javascript",
    "webpack",
    "boilerplate",
    "template",
    "starter"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/FilipNowakWay/vanilla-js-boilerplate/issues"
  },
  "homepage": "https://github.com/FilipNowakWay/vanilla-js-boilerplate#readme",
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@eslint/shell": "^0.1.2",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "3.10.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  }
}
